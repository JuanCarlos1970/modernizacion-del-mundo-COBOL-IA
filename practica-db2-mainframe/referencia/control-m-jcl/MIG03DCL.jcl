//MIG03DCL JOB (ACCT),'DESCARGA CLIENTES',CLASS=A,MSGCLASS=X,
//             NOTIFY=&SYSUID
//*-------------------------------------------------------------------*
//* JCL DE REFERENCIA - NO EJECUTADO EN UN z/OS REAL.
//* JOB DE CONTROL-M: MIG03DCL   (VER DOC DE DISENO CONTROL-M)
//*
//* PROGRAMA : DESCCLI (DESCARGA-CLIENTES)
//* RC       : 0 = DESCARGA COMPLETA
//*            8 = NO PUDO CORRER (ARCHIVO INEXISTENTE, ERROR DE
//*                ARCHIVO O FECHA INVALIDA)
//* REINTENTO: SEGURO. STEP005 BORRA LAS SALIDAS Y STEP010 LAS
//*            VUELVE A GENERAR DESDE CERO.
//* NUNCA CORRER AL MISMO TIEMPO QUE OTRO PROGRAMA QUE USE LOS
//* MISMOS ARCHIVOS.
//*-------------------------------------------------------------------*
//STEP005  EXEC PGM=IEFBR14
//PLANO    DD DSN=USERID.MIG.CLIENTES.TXT,
//            DISP=(MOD,DELETE,DELETE),UNIT=SYSDA,SPACE=(TRK,(1,1))
//LISTADO  DD DSN=USERID.MIG.LISTADO.CLIENTES,
//            DISP=(MOD,DELETE,DELETE),UNIT=SYSDA,SPACE=(TRK,(1,1))
//*
//STEP010  EXEC PGM=DESCCLI
//STEPLIB  DD DISP=SHR,DSN=USERID.COBOL.LOAD
//SYSOUT   DD SYSOUT=*
//SYSUDUMP DD SYSOUT=*
//CLIENTES DD DISP=SHR,DSN=USERID.MIG.CLIENTES.KSDS
//PLANO    DD DSN=USERID.MIG.CLIENTES.TXT,
//            DISP=(NEW,CATLG,CATLG),UNIT=SYSDA,SPACE=(TRK,(5,5),RLSE),
//            DCB=(RECFM=FB,LRECL=107,BLKSIZE=0)
//LISTADO  DD DSN=USERID.MIG.LISTADO.CLIENTES,
//            DISP=(NEW,CATLG,CATLG),UNIT=SYSDA,SPACE=(TRK,(5,5),RLSE),
//            DCB=(RECFM=FB,LRECL=132,BLKSIZE=0)
//FECHAPRO DD *
%%ODATE
/*
