//MIG11CIE JOB (ACCT),'CIERRE ACREDITA INTERES',CLASS=A,MSGCLASS=X,
//             NOTIFY=&SYSUID
//*-------------------------------------------------------------------*
//* JCL DE REFERENCIA - NO EJECUTADO EN UN z/OS REAL.
//* JOB DE CONTROL-M: MIG11CIE   (VER DOC DE DISENO CONTROL-M)
//*
//* PROGRAMA : BATCIERR (BATCH-CIERRE). ACREDITA EL INTERES MENSUAL A
//*            LAS CUENTAS ACTIVAS Y GENERA EL REPORTE DEL CIERRE.
//*   *** HOY BATCH-CIERRE TRABAJA SOBRE EL ARCHIVO INDEXADO
//*       clientes_v3.dat, NO SOBRE Db2. ESTE JCL ASUME UNA VERSION
//*       Db2 DEL PROGRAMA QUE TODAVIA NO EXISTE (SQL EMBEBIDO, PLAN,
//*       CONTROL DE REINICIO COMO EL DE LOS DEPOSITOS). ***
//* RC       : A CONFIRMAR CON EL PROGRAMA REAL.
//* REINTENTO: NO AUTOMATICO. UN CIERRE REPETIDO ACREDITARIA DOS VECES.
//*-------------------------------------------------------------------*
//STEP005  EXEC PGM=IEFBR14
//REPCIERR DD DSN=USERID.MIG.REPORTE.CIERRE,
//            DISP=(MOD,DELETE,DELETE),UNIT=SYSDA,SPACE=(TRK,(1,1))
//*
//STEP010  EXEC PGM=IKJEFT01,DYNAMNBR=20
//STEPLIB  DD DISP=SHR,DSN=DSNC10.SDSNLOAD
//         DD DISP=SHR,DSN=USERID.COBOL.LOAD
//SYSTSPRT DD SYSOUT=*
//SYSPRINT DD SYSOUT=*
//SYSUDUMP DD SYSOUT=*
//REPCIERR DD DSN=USERID.MIG.REPORTE.CIERRE,
//            DISP=(NEW,CATLG,CATLG),UNIT=SYSDA,SPACE=(TRK,(5,5),RLSE),
//            DCB=(RECFM=FB,LRECL=132,BLKSIZE=0)
//SYSIN    DD *
DEP%%ODATE-01
/*
//SYSTSIN  DD *
  DSN SYSTEM(DB2P)
  RUN PROGRAM(BATCIERR) PLAN(CIEPLAN) -
      LIB('USERID.COBOL.LOAD')
  END
/*
