//MIG10DEP JOB (ACCT),'DEPOSITOS DB2 BATCH',CLASS=A,MSGCLASS=X,
//             NOTIFY=&SYSUID
//*-------------------------------------------------------------------*
//* JCL DE REFERENCIA - NO EJECUTADO EN UN z/OS REAL.
//* ES EL MISMO JCL DEPODB2B CON UNA UNICA DIFERENCIA: EL ID DE LOTE
//* (SYSIN) LO ARMA CONTROL-M CON LA FECHA DE ORDEN (DEP%%ODATE-01).
//* EL MIEMBRO ES MIG10DEP; EL PROGRAMA SIGUE SIENDO DEPODB2B.
//*
//* EJECUTA EL PROGRAMA BATCH DEPOSITO-DB2-BATCH (SQL EMBEBIDO).
//* APLICA DEPOSITOS MASIVOS SOBRE LA TABLA CLIENTES DE Db2.
//*
//* PASOS:
//*   STEP005  BORRA LOS LISTADOS DE LA CORRIDA ANTERIOR
//*   STEP010  EJECUTA EL PROGRAMA BAJO EL MONITOR TSO + DSN
//*   STEP020  SOLO SI HUBO RECHAZOS O ERROR: IMPRIME RPTERR
//*
//* CODIGOS DE RETORNO DEL PROGRAMA (CONDITION CODE DE STEP010):
//*   0   TODO APLICADO
//*   4   TERMINO BIEN, CON RECHAZOS (REVISAR RPTERR)
//*   12  ERROR GRAVE (NO CONECTA, ARCHIVOS, ABORTO, DESCUADRE)
//*
//* ID DE LOTE (SYSIN): UNA LINEA, HASTA 20 CARACTERES. IDENTIFICA LA
//*   CORRIDA DE ESTE ARCHIVO. EN CONTROL-M SE PUEDE ARMAR CON LA
//*   FECHA DE ORDEN (POR EJEMPLO DEP%%ODATE).
//*
//* REINICIO SI EL JOB SE CORTA (CAIDA, ABEND, APAGON):
//*   1. NO CAMBIAR EL ARCHIVO ENTRADA NI EL ID DE LOTE.
//*   2. REENVIAR EL JOB CON RESTART=STEP010 EN LA TARJETA JOB
//*      (EN CONTROL-M: RERUN DESDE EL PASO STEP010).
//*      ASI NO SE EJECUTA STEP005 Y LOS LISTADOS SE CONSERVAN.
//*   3. EL PROGRAMA LEE SU CHECKPOINT EN Db2, SALTEA LO YA
//*      CONFIRMADO Y CONTINUA. LOS LISTADOS SE EXTIENDEN (MOD).
//*   POR ESO LOS LISTADOS TIENEN DISP=(MOD,CATLG,CATLG): SI EL PASO
//*   TERMINA MAL NO SE BORRAN, Y EN UN REINICIO SE AGREGA AL FINAL.
//*
//* NOTAS:
//*   - REEMPLAZAR USERID, DB2P Y LOS NOMBRES DE DATASETS POR LOS
//*     DE LA INSTALACION.
//*   - EL NOMBRE DEL MODULO DE CARGA TIENE COMO MAXIMO 8 CARACTERES:
//*     POR ESO SE LLAMA DEPODB2B Y NO DEPOSITO-DB2-BATCH.
//*   - EL PLAN DEPOPLAN SE GENERA ANTES CON UN JOB APARTE:
//*     PRECOMPILAR (O COPROCESADOR), COMPILAR, LINK-EDIT Y BIND.
//*   - LAS TABLAS CONTROL_PROCESO E HISTORIAL_DEPOSITOS SE CREAN UNA
//*     SOLA VEZ (VER crear_tablas_batch.sql).
//*   - ESTE JOB ES EL QUE SE PLANIFICA EN CONTROL-M.
//*-------------------------------------------------------------------*
//*
//STEP005  EXEC PGM=IEFBR14
//RPTOK    DD DSN=USERID.DEPOSITOS.RPTOK,
//            DISP=(MOD,DELETE,DELETE),
//            UNIT=SYSDA,SPACE=(TRK,(1,1))
//RPTERR   DD DSN=USERID.DEPOSITOS.RPTERR,
//            DISP=(MOD,DELETE,DELETE),
//            UNIT=SYSDA,SPACE=(TRK,(1,1))
//*
//STEP010  EXEC PGM=IKJEFT01,DYNAMNBR=20
//STEPLIB  DD DISP=SHR,DSN=DSNC10.SDSNLOAD
//         DD DISP=SHR,DSN=USERID.COBOL.LOAD
//SYSTSPRT DD SYSOUT=*
//SYSPRINT DD SYSOUT=*
//SYSUDUMP DD SYSOUT=*
//ENTRADA  DD DISP=SHR,DSN=USERID.DEPOSITOS.ENTRADA
//RPTOK    DD DSN=USERID.DEPOSITOS.RPTOK,
//            DISP=(MOD,CATLG,CATLG),
//            UNIT=SYSDA,SPACE=(TRK,(5,5),RLSE),
//            DCB=(RECFM=FB,LRECL=132,BLKSIZE=0)
//RPTERR   DD DSN=USERID.DEPOSITOS.RPTERR,
//            DISP=(MOD,CATLG,CATLG),
//            UNIT=SYSDA,SPACE=(TRK,(5,5),RLSE),
//            DCB=(RECFM=FB,LRECL=132,BLKSIZE=0)
//SYSIN    DD *
DEP%%ODATE-01
/*
//SYSTSIN  DD *
  DSN SYSTEM(DB2P)
  RUN PROGRAM(DEPODB2B) PLAN(DEPOPLAN) -
      LIB('USERID.COBOL.LOAD')
  END
/*
//*
//* STEP020: SE EJECUTA SOLO SI STEP010 TERMINO CON RC 4 O MAS
//CHKERR   IF (STEP010.RC >= 4) THEN
//STEP020  EXEC PGM=IEBGENER
//SYSPRINT DD SYSOUT=*
//SYSUT1   DD DISP=SHR,DSN=USERID.DEPOSITOS.RPTERR
//SYSUT2   DD SYSOUT=*
//SYSIN    DD DUMMY
//         ENDIF
