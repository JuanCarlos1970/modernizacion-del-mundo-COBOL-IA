//MIG09LIM JOB (ACCT),'LISTADOS Y CONTROL IMPORT',CLASS=A,MSGCLASS=X,
//             NOTIFY=&SYSUID
//*-------------------------------------------------------------------*
//* JCL DE REFERENCIA - NO EJECUTADO EN UN z/OS REAL.
//* JOB DE CONTROL-M: MIG09LIM   (VER DOC DE DISENO CONTROL-M)
//*
//* PROGRAMA : LISTIMPD (LISTADO-IMPORT-DB2).
//*   *** HOY EXISTE SOLO COMO SCRIPT DE PYTHON EN EL LABORATORIO
//*       (listado_import_db2.py). EN z/OS HABRIA QUE REESCRIBIRLO
//*       EN COBOL; ESTE JCL ASUME ESE PROGRAMA. ***
//* HACE: ARMA EL LISTADO DE REGISTROS CARGADOS Y EL DE RECHAZADOS A
//*   PARTIR DE LOS MENSAJES DE LOS TRES LOAD, Y CONTROLA LO CARGADO
//*   CONTRA EL RESUMEN DEL UTILITARIO Y CONTRA LOS PLANOS.
//* RC       : 0 = LISTADOS COMPLETOS Y CONTROLES QUE CUADRAN
//*            8 = FALTA UN ARCHIVO O LOS CONTROLES NO CUADRAN
//*            (CONVENCION PARA "NO CUADRAN": A DEFINIR AL REESCRIBIR)
//* REINTENTO: SEGURO (SOLO LEE Y GENERA LISTADOS).
//*-------------------------------------------------------------------*
//STEP005  EXEC PGM=IEFBR14
//LISTOK   DD DSN=USERID.MIG.LISTADO.IMPORT.OK,
//            DISP=(MOD,DELETE,DELETE),UNIT=SYSDA,SPACE=(TRK,(1,1))
//LISTERR  DD DSN=USERID.MIG.LISTADO.IMPORT.ERRORES,
//            DISP=(MOD,DELETE,DELETE),UNIT=SYSDA,SPACE=(TRK,(1,1))
//*
//STEP010  EXEC PGM=LISTIMPD
//STEPLIB  DD DISP=SHR,DSN=USERID.COBOL.LOAD
//SYSOUT   DD SYSOUT=*
//SYSUDUMP DD SYSOUT=*
//MSGINT   DD DISP=SHR,DSN=USERID.MIG.IMP.INTERESES.MSG
//MSGCLI   DD DISP=SHR,DSN=USERID.MIG.IMP.CLIENTES.MSG
//MSGPLA   DD DISP=SHR,DSN=USERID.MIG.IMP.PLAZOS.MSG
//TXTINT   DD DISP=SHR,DSN=USERID.MIG.INTERESES.TXT
//TXTCLI   DD DISP=SHR,DSN=USERID.MIG.CLIENTES.TXT
//TXTPLA   DD DISP=SHR,DSN=USERID.MIG.PLAZOS.TXT
//LISTOK   DD DSN=USERID.MIG.LISTADO.IMPORT.OK,
//            DISP=(NEW,CATLG,CATLG),UNIT=SYSDA,SPACE=(TRK,(5,5),RLSE),
//            DCB=(RECFM=FB,LRECL=132,BLKSIZE=0)
//LISTERR  DD DSN=USERID.MIG.LISTADO.IMPORT.ERRORES,
//            DISP=(NEW,CATLG,CATLG),UNIT=SYSDA,SPACE=(TRK,(5,5),RLSE),
//            DCB=(RECFM=FB,LRECL=132,BLKSIZE=0)
