//MIG13FIN JOB (ACCT),'FINALIZACION DE LA CADENA',CLASS=A,MSGCLASS=X,
//             NOTIFY=&SYSUID
//*-------------------------------------------------------------------*
//* JCL DE REFERENCIA - NO EJECUTADO EN UN z/OS REAL.
//* JOB DE CONTROL-M: MIG13FIN   (VER DOC DE DISENO CONTROL-M)
//*
//* HACE: (1) VERIFICA QUE EL LOTE DE DEPOSITOS ESTE EN ESTADO F EN
//*           CONTROL_PROCESO; (2) ARCHIVA LISTADOS EN GDG.
//*   *** VERLOTE ES UN PROGRAMA CHICO (COBOL + SQL EMBEBIDO) QUE
//*       TODAVIA NO EXISTE: HACE UN SELECT DE ESTADO DEL LOTE
//*       RECIBIDO POR SYSIN Y TERMINA CON RC 0 SI ES 'F', RC 8 SI NO.
//*   *** LAS BASES GDG SE CREAN UNA VEZ CON IDCAMS DEFINE GDG. ***
//* RC       : 0 = LOTE EN F Y ARCHIVADO / 8 = LOTE NO FINALIZADO
//* REINTENTO: SEGURO.
//* LAS CONDICIONES DEL CICLO SE BORRAN DESDE CONTROL-M (OUT DEL).
//*-------------------------------------------------------------------*
//STEP010  EXEC PGM=IKJEFT01,DYNAMNBR=20
//STEPLIB  DD DISP=SHR,DSN=DSNC10.SDSNLOAD
//         DD DISP=SHR,DSN=USERID.COBOL.LOAD
//SYSTSPRT DD SYSOUT=*
//SYSPRINT DD SYSOUT=*
//SYSUDUMP DD SYSOUT=*
//SYSIN    DD *
DEP%%ODATE-01
/*
//SYSTSIN  DD *
  DSN SYSTEM(DB2P)
  RUN PROGRAM(VERLOTE) PLAN(VERPLAN) -
      LIB('USERID.COBOL.LOAD')
  END
/*
//*
//* ARCHIVO: SOLO SI EL LOTE QUEDO FINALIZADO
//CHKFIN   IF (STEP010.RC = 0) THEN
//STEP020  EXEC PGM=IEBGENER
//SYSPRINT DD SYSOUT=*
//SYSIN    DD DUMMY
//SYSUT1   DD DISP=SHR,DSN=USERID.DEPOSITOS.RPTOK
//SYSUT2   DD DSN=USERID.MIG.ARCHIVO.RPTOK(+1),
//            DISP=(NEW,CATLG,DELETE),UNIT=SYSDA,
//            SPACE=(TRK,(5,5),RLSE),
//            DCB=(RECFM=FB,LRECL=132,BLKSIZE=0)
//STEP030  EXEC PGM=IEBGENER
//SYSPRINT DD SYSOUT=*
//SYSIN    DD DUMMY
//SYSUT1   DD DISP=SHR,DSN=USERID.DEPOSITOS.RPTERR
//SYSUT2   DD DSN=USERID.MIG.ARCHIVO.RPTERR(+1),
//            DISP=(NEW,CATLG,DELETE),UNIT=SYSDA,
//            SPACE=(TRK,(5,5),RLSE),
//            DCB=(RECFM=FB,LRECL=132,BLKSIZE=0)
//         ENDIF
