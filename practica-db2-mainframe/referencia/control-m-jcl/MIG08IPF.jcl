//MIG08IPF JOB (ACCT),'IMPORT PLAZOS FIJOS',CLASS=A,MSGCLASS=X,
//             NOTIFY=&SYSUID
//*-------------------------------------------------------------------*
//* JCL DE REFERENCIA - NO EJECUTADO EN UN z/OS REAL.
//* JOB DE CONTROL-M: MIG08IPF   (VER DOC DE DISENO CONTROL-M)
//*
//* UTILITARIO: DSNUTILB (UTILITARIO LOAD DE Db2 PARA z/OS).
//*   EQUIVALE AL IMPORT DE Db2 LUW PROBADO EN EL LABORATORIO.
//* CARGA USERID.MIG.PLAZOS.TXT EN LA TABLA PLAZOS_FIJOS.
//* RESUME NO: LA TABLA DEBE ESTAR VACIA. SI YA TIENE FILAS EL
//*   UTILITARIO TERMINA CON ERROR: ESO EVITA CARGAR DOS VECES, PERO
//*   OBLIGA A VACIAR LA TABLA ANTES DE UN REINTENTO. LA ESTRATEGIA
//*   DEFINITIVA (RESUME NO / REPLACE / VACIAR) LA DEFINE EL DBA.
//* LAS FILAS RECHAZADAS VAN AL DD SYSDISC; LOS MENSAJES AL
//*   DD SYSPRINT, QUE LUEGO LEE MIG09LIM.
//* *** LA SENTENCIA LOAD Y SUS OPCIONES SON DE REFERENCIA Y SE
//*     CONFIRMAN CON EL DBA DEL SITIO (NO SE PROBARON EN z/OS). ***
//*-------------------------------------------------------------------*
//STEP005  EXEC PGM=IEFBR14
//SYSPRINT DD DSN=USERID.MIG.IMP.PLAZOS.MSG,
//            DISP=(MOD,DELETE,DELETE),UNIT=SYSDA,SPACE=(TRK,(1,1))
//SYSDISC  DD DSN=USERID.MIG.IMP.PLAZOS.MSG.DISC,
//            DISP=(MOD,DELETE,DELETE),UNIT=SYSDA,SPACE=(TRK,(1,1))
//*
//STEP010  EXEC PGM=DSNUTILB,PARM='DB2P,MIG08IPF'
//STEPLIB  DD DISP=SHR,DSN=DSNC10.SDSNLOAD
//SYSPRINT DD DSN=USERID.MIG.IMP.PLAZOS.MSG,
//            DISP=(NEW,CATLG,CATLG),UNIT=SYSDA,SPACE=(TRK,(5,5),RLSE),
//            DCB=(RECFM=FBA,LRECL=133,BLKSIZE=0)
//UTPRINT  DD SYSOUT=*
//SYSREC   DD DISP=SHR,DSN=USERID.MIG.PLAZOS.TXT
//SYSDISC  DD DSN=USERID.MIG.IMP.PLAZOS.MSG.DISC,
//            DISP=(NEW,CATLG,CATLG),UNIT=SYSDA,SPACE=(TRK,(5,5),RLSE),
//            DCB=(RECFM=FB,LRECL=87,BLKSIZE=0)
//SYSUT1   DD UNIT=SYSDA,SPACE=(CYL,(5,5))
//SORTOUT  DD UNIT=SYSDA,SPACE=(CYL,(5,5))
//SYSIN    DD *
  LOAD DATA INDDN SYSREC LOG YES RESUME NO
       DISCARDDN SYSDISC
       INTO TABLE USERID.PLAZOS_FIJOS
       (PF_NRO       POSITION(1)  INTEGER EXTERNAL(6),
        DNI          POSITION(7)  INTEGER EXTERNAL(8),
        MONEDA       POSITION(15) CHAR(1),
        MONTO        POSITION(16) DECIMAL EXTERNAL(14,2),
        DIAS         POSITION(30) INTEGER EXTERNAL(3),
        TNA_APLICADA POSITION(33) DECIMAL EXTERNAL(6,2),
        INTERES      POSITION(39) DECIMAL EXTERNAL(14,2),
        TOTAL        POSITION(53) DECIMAL EXTERNAL(14,2),
        FECHA_ALTA   POSITION(67) DATE EXTERNAL(10),
        FECHA_VENC   POSITION(77) DATE EXTERNAL(10),
        ESTADO       POSITION(87) CHAR(1))
/*
