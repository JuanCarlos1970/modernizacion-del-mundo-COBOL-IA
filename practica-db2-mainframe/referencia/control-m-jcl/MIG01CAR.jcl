//MIG01CAR JOB (ACCT),'CARGA MASIVA A VSAM',CLASS=A,MSGCLASS=X,
//             NOTIFY=&SYSUID
//*-------------------------------------------------------------------*
//* JCL DE REFERENCIA - NO EJECUTADO EN UN z/OS REAL.
//* JOB DE CONTROL-M: MIG01CAR   (VER DOC DE DISENO CONTROL-M)
//*
//* PROGRAMA : CARGAMAS (CARGA-MASIVA). DA DE ALTA CLIENTES, TASAS Y
//*            PLAZOS FIJOS EN LOS TRES ARCHIVOS VSAM KSDS.
//* RC       : 0 = TODO EL ARCHIVO PROCESADO (CON O SIN RECHAZOS)
//*            8 = NO PUDO CORRER (EL ARCHIVO NO SE RENOMBRA)
//*
//* PASOS:
//*   STEP005  BORRA LOS REPORTES DE LA CORRIDA ANTERIOR
//*   STEP010  EJECUTA LA CARGA
//*   STEP020  SOLO SI STEP010 TERMINO CON RC 0: RENOMBRA EL ARCHIVO
//*            DE CARGA PARA QUE NO SE CARGUE DOS VECES
//*
//* NOTAS:
//*   - EN EL LABORATORIO (GNUCOBOL) EL PROGRAMA RENOMBRA EL ARCHIVO
//*     EL MISMO Y LEE LOS NOMBRES DE ARCHIVO FIJOS. EN z/OS SE
//*     CAMBIARIAN POR DD (ASSIGN TO DDNAME) Y EL RENOMBRADO PASARIA
//*     A STEP020.
//*   - LA FECHA DE PROCESO LA ENTREGA CONTROL-M (%%ODATE) POR EL DD
//*     FECHAPRO. HOY EL PROGRAMA LA LEE DE UNA VARIABLE DE ENTORNO.
//*-------------------------------------------------------------------*
//STEP005  EXEC PGM=IEFBR14
//CARGAOK  DD DSN=USERID.MIG.CARGA.OK,
//            DISP=(MOD,DELETE,DELETE),UNIT=SYSDA,SPACE=(TRK,(1,1))
//CARGARCH DD DSN=USERID.MIG.CARGA.RECHAZOS,
//            DISP=(MOD,DELETE,DELETE),UNIT=SYSDA,SPACE=(TRK,(1,1))
//*
//STEP010  EXEC PGM=CARGAMAS
//STEPLIB  DD DISP=SHR,DSN=USERID.COBOL.LOAD
//SYSOUT   DD SYSOUT=*
//SYSUDUMP DD SYSOUT=*
//CARGA    DD DISP=SHR,DSN=USERID.MIG.CARGA.ENTRADA
//CLIENTES DD DISP=SHR,DSN=USERID.MIG.CLIENTES.KSDS
//INTERES  DD DISP=SHR,DSN=USERID.MIG.INTERES.KSDS
//PLAZOFIJ DD DISP=SHR,DSN=USERID.MIG.PLAZOFIJ.KSDS
//CARGAOK  DD DSN=USERID.MIG.CARGA.OK,
//            DISP=(NEW,CATLG,CATLG),UNIT=SYSDA,SPACE=(TRK,(5,5),RLSE),
//            DCB=(RECFM=FB,LRECL=132,BLKSIZE=0)
//CARGARCH DD DSN=USERID.MIG.CARGA.RECHAZOS,
//            DISP=(NEW,CATLG,CATLG),UNIT=SYSDA,SPACE=(TRK,(5,5),RLSE),
//            DCB=(RECFM=FB,LRECL=132,BLKSIZE=0)
//FECHAPRO DD *
%%ODATE
/*
//*
//* STEP020: RENOMBRA EL ARCHIVO PROCESADO (SOLO SI STEP010 DIO RC 0)
//CHKREN   IF (STEP010.RC = 0) THEN
//STEP020  EXEC PGM=IDCAMS
//SYSPRINT DD SYSOUT=*
//SYSIN    DD *
  ALTER 'USERID.MIG.CARGA.ENTRADA' -
    NEWNAME('USERID.MIG.CARGA.PROC.D%%ODATE')
/*
//         ENDIF
