//MIG12LCL JOB (ACCT),'LISTADO DE CLIENTES',CLASS=A,MSGCLASS=X,
//             NOTIFY=&SYSUID
//*-------------------------------------------------------------------*
//* JCL DE REFERENCIA - NO EJECUTADO EN UN z/OS REAL.
//* JOB DE CONTROL-M: MIG12LCL   (VER DOC DE DISENO CONTROL-M)
//*
//* PROGRAMA : LISTCLI (LISTADO-CLIENTES). LISTADO DE SOLO LECTURA DE
//*            LA CARTERA DE CLIENTES AGRUPADA POR ESTADO.
//*   *** HOY LEE EL ARCHIVO INDEXADO; ESTE JCL ASUME UNA VERSION
//*       QUE LEE LA TABLA CLIENTES DE Db2 (SELECT), TODAVIA NO
//*       ESCRITA. ***
//* RC       : A CONFIRMAR CON EL PROGRAMA REAL.
//* REINTENTO: SEGURO (NO MODIFICA DATOS).
//*-------------------------------------------------------------------*
//STEP005  EXEC PGM=IEFBR14
//LISTCLI  DD DSN=USERID.MIG.LISTADO.CLIENTES.FINAL,
//            DISP=(MOD,DELETE,DELETE),UNIT=SYSDA,SPACE=(TRK,(1,1))
//*
//STEP010  EXEC PGM=IKJEFT01,DYNAMNBR=20
//STEPLIB  DD DISP=SHR,DSN=DSNC10.SDSNLOAD
//         DD DISP=SHR,DSN=USERID.COBOL.LOAD
//SYSTSPRT DD SYSOUT=*
//SYSPRINT DD SYSOUT=*
//SYSUDUMP DD SYSOUT=*
//LISTCLI  DD DSN=USERID.MIG.LISTADO.CLIENTES.FINAL,
//            DISP=(NEW,CATLG,CATLG),UNIT=SYSDA,SPACE=(TRK,(5,5),RLSE),
//            DCB=(RECFM=FB,LRECL=132,BLKSIZE=0)
//SYSTSIN  DD *
  DSN SYSTEM(DB2P)
  RUN PROGRAM(LISTCLI) PLAN(LCLPLAN) -
      LIB('USERID.COBOL.LOAD')
  END
/*
