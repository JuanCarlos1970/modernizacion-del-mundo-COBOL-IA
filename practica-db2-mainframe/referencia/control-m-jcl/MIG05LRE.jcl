//MIG05LRE JOB (ACCT),'LISTADO RECHAZOS CARGA',CLASS=A,MSGCLASS=X,
//             NOTIFY=&SYSUID
//*-------------------------------------------------------------------*
//* JCL DE REFERENCIA - NO EJECUTADO EN UN z/OS REAL.
//* JOB DE CONTROL-M: MIG05LRE   (VER DOC DE DISENO CONTROL-M)
//*
//* PROGRAMA : LISTRECH (LISTADO-RECHAZOS). ARMA EL LISTADO DETALLADO
//*            DE LOS REGISTROS RECHAZADOS POR LA CARGA.
//* RC       : 0 = LISTADO COMPLETO / 8 = FALTA UN ARCHIVO O ERROR
//* REINTENTO: SEGURO (SOLO LEE Y GENERA EL LISTADO).
//* IMPORTANTE: CARGAORI DEBE APUNTAR AL ARCHIVO YA RENOMBRADO POR
//*            MIG01CAR (USERID.MIG.CARGA.PROC.D%%ODATE), DE LA MISMA
//*            CORRIDA QUE LOS RECHAZOS.
//*-------------------------------------------------------------------*
//STEP005  EXEC PGM=IEFBR14
//LISTADO  DD DSN=USERID.MIG.LISTADO.RECHAZOS,
//            DISP=(MOD,DELETE,DELETE),UNIT=SYSDA,SPACE=(TRK,(1,1))
//*
//STEP010  EXEC PGM=LISTRECH
//STEPLIB  DD DISP=SHR,DSN=USERID.COBOL.LOAD
//SYSOUT   DD SYSOUT=*
//SYSUDUMP DD SYSOUT=*
//RECHAZOS DD DISP=SHR,DSN=USERID.MIG.CARGA.RECHAZOS
//CARGAORI DD DISP=SHR,DSN=USERID.MIG.CARGA.PROC.D%%ODATE
//LISTADO  DD DSN=USERID.MIG.LISTADO.RECHAZOS,
//            DISP=(NEW,CATLG,CATLG),UNIT=SYSDA,SPACE=(TRK,(5,5),RLSE),
//            DCB=(RECFM=FB,LRECL=132,BLKSIZE=0)
//FECHAPRO DD *
%%ODATE
/*
