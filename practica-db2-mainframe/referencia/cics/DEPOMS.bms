*  MAPSET DEPOMS - PANTALLA DE DEPOSITO. DISENO DE REFERENCIA,
*  NO ENSAMBLADO. USADO POR EL PROGRAMA DEPOPAN (TRANSACCION DEPO).
DEPOMS   DFHMSD TYPE=&SYSPARM,MODE=INOUT,LANG=COBOL,TIOAPFX=YES,       X
               CTRL=(FREEKB,FRSET),STORAGE=AUTO
DEPOMAP  DFHMDI SIZE=(24,80),LINE=1,COLUMN=1
         DFHMDF POS=(1,2),LENGTH=8,ATTRB=(ASKIP,BRT),                  X
               INITIAL='DEPO0001'
         DFHMDF POS=(1,26),LENGTH=28,ATTRB=(ASKIP,BRT),                X
               INITIAL='DEPOSITO EN CUENTA DE CLIENTE'
         DFHMDF POS=(3,2),LENGTH=20,ATTRB=(ASKIP,NORM),                X
               INITIAL='DNI DEL CLIENTE . .:'
DNI      DFHMDF POS=(3,24),LENGTH=8,ATTRB=(UNPROT,NUM,IC,BRT)
         DFHMDF POS=(3,33),LENGTH=1,ATTRB=(ASKIP)
         DFHMDF POS=(5,2),LENGTH=20,ATTRB=(ASKIP,NORM),                X
               INITIAL='MONTO A DEPOSITAR :'
MONTO    DFHMDF POS=(5,24),LENGTH=12,ATTRB=(UNPROT,NUM,BRT)
         DFHMDF POS=(5,37),LENGTH=1,ATTRB=(ASKIP)
         DFHMDF POS=(8,2),LENGTH=20,ATTRB=(ASKIP,NORM),                X
               INITIAL='CLIENTE . . . . . .:'
NOMBRE   DFHMDF POS=(8,24),LENGTH=30,ATTRB=(ASKIP,NORM)
         DFHMDF POS=(9,2),LENGTH=20,ATTRB=(ASKIP,NORM),                X
               INITIAL='SALDO . . . . . . :'
SALDO    DFHMDF POS=(9,24),LENGTH=17,ATTRB=(ASKIP,NORM)
MSG      DFHMDF POS=(22,2),LENGTH=76,ATTRB=(ASKIP,BRT)
         DFHMDF POS=(24,2),LENGTH=30,ATTRB=(ASKIP,NORM),               X
               INITIAL='ENTER=DEPOSITAR   PF3=SALIR'
         DFHMSD TYPE=FINAL
         END
