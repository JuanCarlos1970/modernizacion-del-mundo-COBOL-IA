//DEPOCSD  JOB (ACCT),'DEFINIR TRANS DEPO',CLASS=A,MSGCLASS=X,
//             NOTIFY=&SYSUID
//*-------------------------------------------------------------------*
//* JCL DE REFERENCIA - NO EJECUTADO EN UN z/OS REAL.
//*
//* DEFINE EN EL CSD DE CICS LOS RECURSOS DE LA TRANSACCION DEPO:
//*   TRANSACTION DEPO     ARRANCA EL PROGRAMA DEPOPAN
//*   PROGRAM DEPOPAN      PROGRAMA DE PANTALLA
//*   PROGRAM DEPOLOG      PROGRAMA DE LOGICA (CON Db2)
//*   PROGRAM DEPOMS       MAPSET (UN MAPSET SE DEFINE COMO PROGRAM)
//*   DB2ENTRY DEPOENT     HILO DE Db2 Y PLAN QUE USA LA TRANSACCION
//*   DB2TRAN  DEPO        ASOCIA LA TRANSACCION CON EL DB2ENTRY
//* TODOS DENTRO DEL GRUPO DEPOGRP.
//*
//* DESPUES DE CORRERLO HAY QUE INSTALAR EL GRUPO EN LA REGION CICS
//* (DESDE CEDA INSTALL GROUP(DEPOGRP) O AGREGANDOLO A UNA LISTA DE
//* ARRANQUE) Y, SI SE CAMBIO UN PROGRAMA, REFRESCAR LA COPIA CARGADA
//* (CEMT SET PROGRAM(DEPOLOG) NEWCOPY).
//*
//* *** LOS ATRIBUTOS DE CADA DEFINICION SON DE REFERENCIA Y SE
//*     CONFIRMAN CON LOS ESTANDARES DEL SITIO (NO SE PROBARON). ***
//* - REEMPLAZAR CICSTS.CICS.* Y LOS NOMBRES DEL CSD POR LOS DEL SITIO.
//* - DEPOCPLN ES EL PLAN DE Db2 DE DEPOLOG (SE HACE UN BIND APARTE).
//*-------------------------------------------------------------------*
//STEPCSD  EXEC PGM=DFHCSDUP,REGION=1M,
//             PARM='CSD(READWRITE),PAGESIZE(60),NOCOMPAT'
//STEPLIB  DD DISP=SHR,DSN=CICSTS.CICS.SDFHLOAD
//DFHCSD   DD DISP=SHR,DSN=CICSTS.CICS.DFHCSD
//SYSPRINT DD SYSOUT=*
//SYSIN    DD *
  DEFINE TRANSACTION(DEPO) GROUP(DEPOGRP)
         PROGRAM(DEPOPAN)
         DESCRIPTION(DEPOSITO EN CUENTA DE CLIENTE)
  DEFINE PROGRAM(DEPOPAN) GROUP(DEPOGRP)
         LANGUAGE(COBOL)
  DEFINE PROGRAM(DEPOLOG) GROUP(DEPOGRP)
         LANGUAGE(COBOL)
  DEFINE PROGRAM(DEPOMS) GROUP(DEPOGRP)
  DEFINE DB2ENTRY(DEPOENT) GROUP(DEPOGRP)
         PLAN(DEPOCPLN)
         THREADLIMIT(5)
  DEFINE DB2TRAN(DEPO) GROUP(DEPOGRP)
         ENTRY(DEPOENT) TRANSID(DEPO)
/*
