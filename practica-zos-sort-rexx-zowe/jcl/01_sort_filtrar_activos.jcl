//SORTOUT  DD DSN=ZID.CLIENTES.ACTIVOS,DISP=(NEW,CATLG,DELETE),
//            SPACE=(TRK,(5,5),RLSE),RECFM=FB,LRECL=107
//SYSIN    DD *
  SORT FIELDS=(1,8,CH,A)
  INCLUDE COND=(107,1,CH,EQ,C'A')
